    "start": "vite preview",
    "_comment": "Run npm install before these commands."
  },
  "dependencies": {
    "@huggingface/transformers": "^3.0.0",
    "vite": "^5.4.8",
    "typescript": "^5.5.0",
    "vitest": "^2.1.2",
    "prettier": "^3.3.3"
  }
}
